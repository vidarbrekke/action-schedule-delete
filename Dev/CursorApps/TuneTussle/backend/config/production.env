# ─────────────────────────────────────────────────────────────
# production.env — Production Environment for 1GB Linux Servers
# Optimized configuration for memory-constrained environments
# Copy to .env for production deployment
# ─────────────────────────────────────────────────────────────

########################################
# OpenRouter AI Configuration
########################################
OPENROUTER_API_KEY=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
OPENROUTER_MODEL_ID=qwen/qwen3-235b-a22b:free
# OPENROUTER_API_BASE_URL=https://your-custom-proxy.com/v1

########################################
# YouTube Data API Configuration
########################################
# Use SCRAPE method to avoid API quotas on resource-constrained servers
YOUTUBE_FETCH_METHOD=SCRAPE
# YOUTUBE_API_KEY=your_youtube_api_key_here

########################################
# Application Configuration - OPTIMIZED FOR 1GB SERVERS
########################################
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Memory optimization settings
NODE_OPTIONS=--max-old-space-size=768 --gc-interval=100

# Disable unnecessary features for production
DISABLE_LOGGING_COLORS=true
LOG_LEVEL=warn

########################################
# Performance Tuning for 1GB Servers
########################################
# Reduce concurrent connections
UV_THREADPOOL_SIZE=2

# Enable garbage collection optimizations
NODE_GC_AGGRESSIVE=true

########################################
# Security Configuration
########################################
# SESSION_SECRET=your_very_strong_session_secret_here
# CORS_ORIGIN=https://your-frontend-domain.com

########################################
# Database Configuration (Future)
########################################
# DATABASE_URL=postgresql://user:password@localhost:5432/tunetussle
# REDIS_URL=redis://localhost:6379 

########################################
# Music Provider Configuration
########################################
# Primary Music Provider Selection
# Controls which music service is used for fetching track URLs/previews.
# Options:
#   deezer - Uses Deezer for 30-second preview clips (no authentication required)
#   spotify - Uses Spotify for 30-second preview clips
#   youtube - Uses YouTube for track links (default)
# Note: If primary provider fails, the system will automatically fall back to other providers
MUSIC_PROVIDER=deezer 