# ─────────────────────────────────────────────────────────────
# development.env — Development Environment for TuneTussle
# Uses mock services and default configurations for development
# Copy to .env for development setup
# ─────────────────────────────────────────────────────────────

########################################
# Development Mode Configuration
########################################
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

########################################
# Mock LLM Configuration for Development
########################################
# Using placeholder values - real API not required for basic testing
OPENROUTER_API_KEY=dev_mock_key_placeholder
OPENROUTER_MODEL_ID=qwen/qwen3-235b-a22b:free
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1/chat/completions

########################################
# YouTube Configuration - Optional for dev
########################################
# Use SCRAPE method to avoid API quotas during development
YOUTUBE_FETCH_METHOD=SCRAPE
# YOUTUBE_API_KEY=optional_for_development

########################################
# Spotify Configuration - Optional for dev  
########################################
# SPOTIFY_CLIENT_ID=optional_for_development
# SPOTIFY_CLIENT_SECRET=optional_for_development

########################################
# Music Provider Configuration
########################################
# Primary Music Provider Selection for development
# Deezer works without authentication - perfect for development
MUSIC_PROVIDER=deezer

########################################
# Development Logging
########################################
LOG_LEVEL=debug
DISABLE_LOGGING_COLORS=false

########################################
# Development Performance Settings
########################################
# More generous settings for development
UV_THREADPOOL_SIZE=4
NODE_OPTIONS=--max-old-space-size=2048 