{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "npm run clean && npm run build:prod && node --max-old-space-size=768 --gc-interval=100 dist/index.js",
    "start:dev": "ts-node src/index.ts",
    "start:prod": "node --max-old-space-size=768 --gc-interval=100 dist/index.js",
    "build": "tsc",
    "build:prod": "tsc --project tsconfig.prod.json",
    "clean": "rm -rf dist",
    "dev": "nodemon src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.9.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "googleapis": "^148.0.0",
    "node-fetch": "^3.3.2",
    "openai": "^4.103.0",
    "socket.io": "^4.8.1",
    "spotify-preview-finder": "^1.1.1"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.17",
    "@types/node-fetch": "^2.6.12",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
